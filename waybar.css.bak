/* waybar.css */
* {
    border: none;
    border-radius: 0;
    font-family: "JetBrainsMono Nerd Font", sans-serif;
    font-size: 13px;
    min-height: 0;
}

window#waybar {
    background: rgba(44, 43, 42, 0.95);
    color: #d1ccc3;
    border-bottom: 1px solid rgba(210, 203, 189, 0.8);
}

/* Container styling for animated workspaces */
#workspaces {
    background-color: rgba(24, 24, 37, 0.6);
    border-radius: 16px;
    margin: 4px;
    padding: 2px 6px;
}

/* Default button state (Inactive workspaces) */
#workspaces button {
    padding: 0px 8px;
    margin: 3px 2px;
    border-radius: 12px;
    background-color: rgba(255, 255, 255, 0.1);
    color: #d1ccc3;
    border: none;
    min-width: 24px;

    /* Smooth CSS transitions for state changes */
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

/* Hover effect */
#workspaces button:hover {
    background-color: rgba(255, 255, 255, 0.25);
    color: #ffffff;
    padding: 0px 12px;
    box-shadow: inherit;
    text-shadow: inherit;
}

/* Active workspace button (Expanding pill animation) */
#workspaces button.focused {
    background-color: #89b4fa;
    color: #11111b;
    padding: 0px 18px; /* Expands width dynamically on activation */
    border-radius: 16px;
    font-weight: bold;
}

/* Urgent workspace state */
#workspaces button.urgent {
    background-color: #f38ba8;
    color: #11111b;
    padding: 0px 14px;
}

#clock, #battery, #network, #pulseaudio, #tray {
    padding: 0 12px;
    margin: 2px 0;
    border: 1px solid rgba(210, 203, 189, 0.4);
}